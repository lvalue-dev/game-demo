{
  "name": "hantang-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "한탕(가제) 덱빌딩 로그라이크 규칙 검증용 웹 프로토타입",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "build:western": "node scripts/build.mjs --project western",
    "dev:western": "node scripts/build.mjs --project western --serve",
    "test": "node --test \"tests/*.test.ts\" \"western/tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sim": "node scripts/sim.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.10.0",
    "@types/three": "^0.158.3",
    "esbuild": "^0.24.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.158.0",
    "typescript": "^5.8.0"
  }
}
